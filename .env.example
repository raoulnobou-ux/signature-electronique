# ---------------------------------------------------------------------------
# QuickSign — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# En local, `npm run db:start` affiche les clés Supabase à utiliser.
# ---------------------------------------------------------------------------

# URL publique de l'application (sans / final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète « service_role » : serveur uniquement, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Connexion avec Google : "true" une fois le fournisseur Google activé dans Supabase
# (Authentication → Providers → Google), sinon le bouton est masqué.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Utilisées uniquement par Supabase local (supabase/config.toml) pour tester Google
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Taille maximale d'un fichier importé, en Mo (défaut : 25)
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Assistant IA (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Seulement si la clé n'est rattachée à aucun espace de travail (console → Workspaces → ID)
ANTHROPIC_WORKSPACE_ID=
# Sans clé : "true" active un assistant SIMULÉ (réponses scriptées) pour le développement
# et les tests e2e. Jamais pris en compte en production Vercel.
AI_MOCK=

# Conversion Word → PDF (Gotenberg). En local : docker compose up gotenberg
GOTENBERG_URL=http://127.0.0.1:3001
# Jeton partagé exigé par le proxy devant Gotenberg en production (en-tête Authorization)
GOTENBERG_TOKEN=

# E-mails transactionnels — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="QuickSign <bonjour@quicksign.app>"

# Prestataires de paiement activés, séparés par des virgules (ex. notchpay) ;
# vide = tous ceux dont les clés sont renseignées. Retirer un nom le désactive.
PAYMENT_PROVIDERS=

# Notch Pay — page de paiement hébergée, en FCFA (moyens affichés lus sur le compte Notch Pay)
# Tableau de bord Notch Pay → Paramètres → Clés API : clé publique (pk.… ; test : pk_test.…)
NOTCHPAY_PUBLIC_KEY=
# Webhook à déclarer dans Notch Pay : https://<domaine>/api/webhooks/notchpay
# Clé de hachage du webhook (« Hash Key ») — obligatoire : sans elle, toute notification est refusée
NOTCHPAY_WEBHOOK_SECRET=

# Chariow — carte bancaire et autres moyens (page Chariow), en FCFA. Guide : docs/PAIEMENTS.md
# Chariow → Paramètres → Clés API ; scopes : checkout.write, sales.read, products.read
CHARIOW_API_KEY=
# Chariow → Automatisations → Pulses → (Pulse vers https://<domaine>/api/webhooks/chariow) → Signing secret
CHARIOW_PULSE_SECRET=
# Identifiants des 4 produits (type Licence, prix en FCFA identiques à plans_config) ; un vide = plan non proposé
CHARIOW_PRODUCT_ESSENTIAL_MONTHLY=
CHARIOW_PRODUCT_ESSENTIAL_YEARLY=
CHARIOW_PRODUCT_PRO_MONTHLY=
CHARIOW_PRODUCT_PRO_YEARLY=

# Sans prestataire : "true" active un paiement SIMULÉ (développement et tests e2e).
# Jamais pris en compte en production Vercel. Laisser vide en production.
PAYMENTS_SANDBOX=

# Secret des liens de signature envoyés aux signataires (≥ 32 caractères aléatoires :
# openssl rand -base64 48). Le changer invalide tous les liens en cours.
LINK_SECRET=

# Surveillance des erreurs — https://sentry.io
SENTRY_DSN=

# Secret des tâches planifiées (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
