# ---------------------------------------------------------------------------
# QuickSign — variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# En local, `npm run db:start` affiche les clés Supabase à utiliser.
# ---------------------------------------------------------------------------

# URL publique de l'application (sans / final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète « service_role » : serveur uniquement, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Connexion avec Google : "true" une fois le fournisseur Google activé dans Supabase
# (Authentication → Providers → Google), sinon le bouton est masqué.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
# Utilisées uniquement par Supabase local (supabase/config.toml) pour tester Google
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Taille maximale d'un fichier importé, en Mo (défaut : 25)
NEXT_PUBLIC_MAX_UPLOAD_MB=25

# Assistant IA (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Conversion Word → PDF (Gotenberg). En local : docker compose up gotenberg
GOTENBERG_URL=http://127.0.0.1:3001
# Jeton partagé exigé par le proxy devant Gotenberg en production (en-tête Authorization)
GOTENBERG_TOKEN=

# E-mails transactionnels — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="QuickSign <bonjour@quicksign.app>"

# Paiements — Flutterwave (Dashboard → Settings → API Keys / Webhooks)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# « Secret hash » défini dans le tableau de bord Flutterwave (Settings → Webhooks) ; il authentifie
# les webhooks envoyés à https://<domaine>/api/webhooks/flutterwave
FLUTTERWAVE_WEBHOOK_HASH=
# Sans clé Flutterwave : "true" active un paiement SIMULÉ (développement et tests e2e).
# Jamais pris en compte en production Vercel. Laisser vide en production.
PAYMENTS_SANDBOX=

# Surveillance des erreurs — https://sentry.io
SENTRY_DSN=

# Secret des tâches planifiées (Vercel Cron envoie Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
